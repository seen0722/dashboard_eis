# EIS MCP server 前置 nginx 範例（內網主機）。TLS 憑證與 server_name 依主機調整。
# /mcp 與 /upload/ 需要 Bearer token（服務自己檢查）；/ui/ 免 token、唯讀，只該開在內網。
server {
    listen 443 ssl http2;
    server_name eis-host;
    ssl_certificate     /etc/ssl/eis-host/fullchain.pem;
    ssl_certificate_key /etc/ssl/eis-host/privkey.pem;
    client_max_body_size 64m;          # 每月 Excel 包

    location /mcp     { proxy_pass http://127.0.0.1:8765; proxy_set_header Host $host; proxy_read_timeout 120s; }
    location /upload/ { proxy_pass http://127.0.0.1:8765; proxy_set_header Host $host; proxy_request_buffering off; }
    location /ui/     { proxy_pass http://127.0.0.1:8765; proxy_set_header Host $host; }
    location = /ui    { return 301 /ui/; }
    location /        { return 404; }
}
