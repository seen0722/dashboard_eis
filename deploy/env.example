# /etc/eis-mcp/env — EIS MCP server 的環境設定（systemd EnvironmentFile）
# 複製到 /etc/eis-mcp/env 後修改；chmod 640、owner root:eis。

# 監聽位址與 port。內網服務用 0.0.0.0；若前面有 nginx 反向代理則改 127.0.0.1
EIS_BIND_HOST=0.0.0.0
EIS_PORT=8765

# DNS-rebinding 防護：填 client 會用的 Host header（主機名或 IP，含 port），可多個用空白分隔
#   例：EIS_ALLOWED_HOST_ARG="--allowed-host eis-host:8765 --allowed-host 10.1.2.3:8765"
# 留空則關閉防護（有 Bearer token 擋著，風險低，但建議填）。
EIS_ALLOWED_HOST_ARG=--allowed-host eis-host:8765
